# Mati / MetaMap — visibles en el cliente (web button)
NEXT_PUBLIC_METAMAP_CLIENT_ID=
NEXT_PUBLIC_METAMAP_FLOW_ID=
# Opcional: identidad fija para pruebas sin llamar a la API
NEXT_PUBLIC_METAMAP_IDENTITY_ID=

# Mati — solo servidor (crear identityId al entrar al paso selfie; pruebas sin backend de números)
# Client Secret del dashboard MetaMap → Integration (mismo par que clientId del web button)
MATI_CLIENT_SECRET=
# Alias aceptado:
# METAMAP_CLIENT_SECRET=
# Opcional si difieren de las públicas:
# MATI_CLIENT_ID=
# MATI_FLOW_ID=
# Base API (por defecto https://api.prod.metamap.com)
# MATI_API_BASE_URL=
